  <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/"> 
   <dc:format>application/pdf</dc:format> 
   <dc:title><rdf:Alt><rdf:li xml:lang="x-default">Git-Based Software Metrics for Evidence-Based Developer Reputation: Comparative Evaluation and Smart Contract Feasibility</rdf:li></rdf:Alt></dc:title>
   <dc:creator><rdf:Seq><rdf:li>Ali Bakhshayesh</rdf:li></rdf:Seq></dc:creator>
   <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
   <dc:subject><rdf:Bag><rdf:li>software metrics</rdf:li>
     <rdf:li>developer reputation</rdf:li>
     <rdf:li>open-source software</rdf:li>
     <rdf:li>Hyperledger Fabric</rdf:li>
     <rdf:li>smart contracts</rdf:li>
     <rdf:li>reproducibility</rdf:li></rdf:Bag></dc:subject>
  </rdf:Description> 
